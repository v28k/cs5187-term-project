# DuckDB dialect overlay for grammar/postgres.pgg (format: pgfuzz/grammar/overlay.py).
# Part 1 removes PostgreSQL-only features; part 2 adds DuckDB features.

# ---------------------------------------------------------------- part 1: not in DuckDB
# (literal and fill tables: grammar/overlays/duckdb.data.yaml)
%droptype int4range

# jsonb operators / functions / SQL-JSON syntax DuckDB does not have (jsonb = DuckDB JSON here)
%drop expr "\"?\" ("
%drop expr "\"@?\""
%drop expr "\"@@\""
%drop expr "\"#>\""
%drop expr "\"#-\""
%drop expr "\"-\" \"'k'\""
%drop expr "JSONB_"
%drop expr "TO_JSONB"
%drop expr "JSON_VALUE"
%drop expr "JSON_QUERY"
%drop expr "JSON_EXISTS"
%drop expr "JSON_OBJECT"
%drop expr "JSON_ARRAY"
%drop expr "IS NOT?0.3 JSON"
%drop expr "(\"@>\" | \"<@\") expr<jsonb>"
%drop expr "\"||\" expr<jsonb>"
%drop srf_item "JSONB_"
%drop srf_item "JSON_TABLE"
%drop srf_item "ROWS FROM"
%drop srf_item "WITH ORDINALITY"
%droprule jobj
%drop agg "JSONB_AGG"
%drop agg "JSON_AGG"

# functions / operators missing in DuckDB
%drop expr "WIDTH_BUCKET"
%drop expr "SCALE"
%drop expr "INITCAP"
%drop expr "TO_CHAR"
%drop expr "NORMALIZE"
%drop expr "JUSTIFY_HOURS"
%drop expr "MAKE_INTERVAL"
%drop expr "TRIM_ARRAY"
%drop expr "ARRAY_POSITIONS"
%drop expr "ARRAY_REMOVE"
%drop expr "REGEXP_SPLIT_TO_ARRAY"
%drop expr "\"^@\""
%drop expr "SIMILAR TO"
%drop expr "COLLATE"
%drop expr "TO_TIMESTAMP"
%drop expr "ARRAY in_sub"
%drop expr "\"[\" (\"1\" | \"2\") \":\""
%drop expr "'{}'::int[]"
%drop expr "(\"~\" | \"~*\" | \"!~\")"
%drop expr "<<"
%drop expr "EXTRACT \"(\" (EPOCH | DAY | HOUR) FROM expr<interval>"
%drop agg "MODE"
%drop agg "EVERY"
%drop agg "REGR_SLOPE"

# window: IGNORE NULLS / EXCLUDE combos are kept (DuckDB supports them); GROUPS frames too

# DML: MERGE RETURNING merge_action(), bare ON CONFLICT, RETURNING old./new.
%drop on_conflict "ON CONFLICT DO NOTHING"
%drop returning "\"old.\""
%droprule merge_returning

# EXPLAIN options
%droprule explain_stmt
explain_stmt : <2> EXPLAIN query ;

# DDL that DuckDB does not have
%droprule create_stats
%droprule create_cast
%droprule alter_table
%drop create_index "USING"
%replace create_index "CREATE INDEX ON" "CREATE INDEX @fresh_name(i) ON"
%dropopt create_index "INCLUDE"
%dropopt create_index "WHERE"
%dropopt index_col "NULLS FIRST"
%drop index_col "COALESCE"
%drop create_table "UNLOGGED"
%drop create_table "PARTITION BY"
%replace create_table "\";\" ANALYZE @target_name" ""
%replace ctas "\";\" ANALYZE @target_name" ""
%drop new_col "GENERATED ALWAYS AS IDENTITY"
%dropopt new_col "STORED"
%drop create_view "matview_def"
%drop setup_stmt "ANALYZE @table"

# settings: DuckDB has no SET LOCAL; the driver resets these after every test case
%droprule set_stmt
set_stmt
  : <2> SET "disabled_optimizers" "=" duck_rule
  | <1> SET "threads" "=" ("1" | "3")
  | <1> SET "preserve_insertion_order" "=" ("true" | "false")
  | <0.5> SET "default_null_order" "=" ("'nulls_first'" | "'nulls_last'")
  ;
duck_rule : "'filter_pushdown'" | "'join_order'" | "'statistics_propagation'" | "'unnest_rewriter'"
          | "'build_side_probe_side'" | "'compressed_materialization'" | "'top_n'" | "'reorder_filter'"
          | "'common_subexpressions'" | "'late_materialization'" | "'join_filter_pushdown'" ;

# ---------------------------------------------------------------- batch 2 (from measured errors)
%drop expr "NOT IN in_sub<int>"
%drop expr "CONCAT \"(\" expr<*>"
%drop expr "CONCAT_WS"
%drop rec_cte "SEARCH"
%drop rec_cte "CYCLE"

# DuckDB: no subqueries in RETURNING
%droprule returning_item
returning_item<T> : <3> @col(T) | <1> @lit(T) | <1> COALESCE "(" @col(T) "," @lit(T) ")" ;

# index keys must be scalar (no lists, no intervals, no JSON)
%addclass int idx
%addclass bigint idx
%addclass numeric idx
%addclass float8 idx
%addclass text idx
%addclass bool idx
%addclass date idx
%addclass tstz idx
%replace index_col "@target_col(ord)" "@target_col(idx)"

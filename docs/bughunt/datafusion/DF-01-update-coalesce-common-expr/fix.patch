index 9d3ecf2..fba2fa7 100644
--- a/datafusion/sqllogictest/test_files/dml_update.slt
+++ b/datafusion/sqllogictest/test_files/dml_update.slt
@@ -423,6 +423,41 @@ SELECT * FROM test_update_false;
 statement ok

From 64cf13109104416f86859c05e3d0942faee055b8 Mon Sep 17 00:00:00 2001
From: Venu Kummari <v.kummari@iitg.ac.in>
Date: Sun, 8 Nov 2026 08:08:35 +0000
Subject: [PATCH] core/translate: read external aggregate arguments into
 consecutive registers

The step of an external aggregate reads its arguments from consecutive
registers, but each argument was resolved into a register of its own
choosing. When the first argument is an expression, its temporaries sit
between the arguments, so percentile_disc(a + 0, 1) read a temporary as
the fraction and failed with "Percentile value must be between 0.0 and
1.0", and percentile_disc(length(b), 1) returned NULL. Translate all
arguments into one block of registers instead.
---
 core/translate/aggregation.rs                 | 42 +++++++++++++----
 .../percentile-expression-argument.sqltest    | 45 +++++++++++++++++++
 2 files changed, 78 insertions(+), 9 deletions(-)
 create mode 100644 sqlite/conformance/sqlite-sqltests/agg-functions/percentile-expression-argument.sqltest

diff --git a/core/translate/aggregation.rs b/core/translate/aggregation.rs
index 27a83ca1d..bed2b5db7 100644
--- a/core/translate/aggregation.rs
+++ b/core/translate/aggregation.rs
@@ -329,6 +329,35 @@ impl<'a> AggArgumentSource<'a> {
             }
         }
     }
+
+    /// Emit bytecode to read all aggregate function arguments into consecutive registers,
+    /// returning the first one.
+    pub fn translate_all(
+        &self,
+        program: &mut ProgramBuilder,
+        referenced_tables: &TableReferences,
+        resolver: &Resolver,
+    ) -> Result<usize> {
+        match self {
+            AggArgumentSource::Register {
+                src_reg_start: start_reg,
+                ..
+            } => Ok(*start_reg),
+            AggArgumentSource::Expression { args, .. } => {
+                let start_reg = program.alloc_registers(args.len());
+                for (i, arg) in args.iter().enumerate() {
+                    translate_expr(
+                        program,
+                        Some(referenced_tables),
+                        arg,
+                        start_reg + i,
+                        resolver,
+                    )?;
+                }
+                Ok(start_reg)
+            }
+        }
+    }
 }
 
 pub fn emit_aggregate_step(
@@ -826,16 +855,11 @@ pub fn translate_aggregation_step(
             let expr_reg = if argc == 0 {
                 0
             } else {
-                agg_arg_source.translate(program, referenced_tables, resolver, 0)?
+                agg_arg_source.translate_all(program, referenced_tables, resolver)?
             };
-            for i in 0..argc {
-                if i != 0 {
-                    let _ = agg_arg_source.translate(program, referenced_tables, resolver, i)?;
-                }
-                // invariant: distinct aggregates are only supported for single-argument functions
-                if argc == 1 {
-                    handle_distinct(program, agg_arg_source.distinctness(), expr_reg + i);
-                }
+            // invariant: distinct aggregates are only supported for single-argument functions
+            if argc == 1 {
+                handle_distinct(program, agg_arg_source.distinctness(), expr_reg);
             }
             program.emit_insn(Insn::AggStep {
                 data: Box::new(AggStepData {
diff --git a/sqlite/conformance/sqlite-sqltests/agg-functions/percentile-expression-argument.sqltest b/sqlite/conformance/sqlite-sqltests/agg-functions/percentile-expression-argument.sqltest
new file mode 100644
index 000000000..1dea05efd
--- /dev/null
+++ b/sqlite/conformance/sqlite-sqltests/agg-functions/percentile-expression-argument.sqltest
@@ -0,0 +1,45 @@
+@database :memory:
+
+# The value and the fraction of percentile_disc(Y, P) and percentile_cont(Y, P)
+# must reach the aggregate in their own registers when Y is an expression.
+
+test percentile-disc-expression-value {
+    CREATE TABLE t(a INTEGER, b TEXT);
+    INSERT INTO t VALUES(1, 'x'), (2, 'y');
+    SELECT percentile_disc(a + 0, 1) FROM t;
+}
+expect {
+    2.0
+}
+
+test percentile-disc-function-value {
+    CREATE TABLE t(a INTEGER, b TEXT);
+    INSERT INTO t VALUES(1, 'x'), (2, 'y');
+    SELECT percentile_disc(length(b), 1) FROM t;
+}
+expect {
+    1.0
+}
+
+test percentile-cont-expression-value {
+    SELECT percentile_cont('5' + 0, 0.5);
+}
+expect {
+    5.0
+}
+
+test percentile-disc-function-value-no-rows-read {
+    SELECT percentile_disc(abs(''), 1);
+}
+expect {
+    0.0
+}
+
+test percentile-cont-expression-value-and-fraction {
+    CREATE TABLE t(a INTEGER);
+    INSERT INTO t VALUES(1), (2), (3), (4);
+    SELECT percentile_cont(a * 10, 0.25 + 0.25) FROM t;
+}
+expect {
+    25.0
+}
-- 

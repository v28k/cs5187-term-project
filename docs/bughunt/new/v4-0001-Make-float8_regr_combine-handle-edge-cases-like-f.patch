From deb8e2026271c011d6898912af77d72ba4b83b47 Mon Sep 17 00:00:00 2001
From: Tom Lane <tgl@sss.pgh.pa.us>
Date: Wed, 11 Nov 2026 15:08:56 -0500
Subject: [PATCH v4] Make float8_regr_combine() handle edge cases like
 float8_regr_accum().

Commit 649828769 taught float8_regr_accum() to keep Sxx, Syy and Sxy
exactly zero while all the inputs for X (or Y) are the same, so that
corr() and the regr_*() functions return NULL for a constant input.
Then 7774249d0 made it force Sxy to NaN when one input is constant
and the other is Inf or NaN.  float8_regr_combine() got neither
change: it still added the correction terms computed from the rounded
sums Sx1 and Sx2, which are usually slightly nonzero even when both
states saw the same single value.  Thus, the edge cases those commits
intended to fix occurred anyway under parallel aggregation.

Skip each correction term when the corresponding input(s) have a
common value, and force Sxy to NaN when the Sxy correction is skipped
and the other input has seen an Inf or NaN.

Also, make the overflow handling in float8_regr_combine() look more
like float8_regr_accum().  It might have worked out the same in terms
of when we throw error or don't, but even if that's true, proving it
and then keeping it true in the future requires brain cells readers
shouldn't have to expend.

In the existing direct test of float8_regr_combine(), the two states
are those of the regr_test rows with x IN (10,20,30) and x IN (80,100),
but their commonX/commonY entries didn't match those rows.  Set them
to NaN, so that the test exercises the correction terms and its result
again agrees with the aggregates over the whole table.  Also test that
overflow is reported and that an infinite input is not an overflow.

Bug: #19826
Reported-by: Venu Kummari <venu2805k@gmail.com>
Author: Venu Kummari <venu2805k@gmail.com>
Reviewed-by: Tom Lane <tgl@sss.pgh.pa.us>
Discussion: https://postgr.es/m/19826-4b769cb5342fdfe7@postgresql.org
Backpatch-through: 19
---
 src/backend/utils/adt/float.c            | 72 ++++++++++++++++----
 src/test/regress/expected/aggregates.out | 87 ++++++++++++++++++++++--
 src/test/regress/sql/aggregates.sql      | 38 ++++++++++-
 3 files changed, 177 insertions(+), 20 deletions(-)

diff --git a/src/backend/utils/adt/float.c b/src/backend/utils/adt/float.c
index 38ef6da..f2fe0f5 100644
--- a/src/backend/utils/adt/float.c
+++ b/src/backend/utils/adt/float.c
@@ -3649,19 +3649,10 @@ float8_regr_combine(PG_FUNCTION_ARGS)
 	else
 	{
 		N = N1 + N2;
-		Sx = float8_pl(Sx1, Sx2);
-		tmp1 = Sx1 / N1 - Sx2 / N2;
-		Sxx = Sxx1 + Sxx2 + N1 * N2 * tmp1 * tmp1 / N;
-		if (unlikely(isinf(Sxx)) && !isinf(Sxx1) && !isinf(Sxx2))
-			float_overflow_error();
-		Sy = float8_pl(Sy1, Sy2);
-		tmp2 = Sy1 / N1 - Sy2 / N2;
-		Syy = Syy1 + Syy2 + N1 * N2 * tmp2 * tmp2 / N;
-		if (unlikely(isinf(Syy)) && !isinf(Syy1) && !isinf(Syy2))
-			float_overflow_error();
-		Sxy = Sxy1 + Sxy2 + N1 * N2 * tmp1 * tmp2 / N;
-		if (unlikely(isinf(Sxy)) && !isinf(Sxy1) && !isinf(Sxy2))
-			float_overflow_error();
+		Sx = Sx1 + Sx2;
+		Sy = Sy1 + Sy2;
+
+		/* Check to see if we have seen distinct inputs */
 		if (float8_eq(Cx1, Cx2))
 			Cx = Cx1;
 		else
@@ -3670,6 +3661,61 @@ float8_regr_combine(PG_FUNCTION_ARGS)
 			Cy = Cy1;
 		else
 			Cy = get_float8_nan();
+
+		tmp1 = Sx1 / N1 - Sx2 / N2;
+		tmp2 = Sy1 / N1 - Sy2 / N2;
+
+		/*
+		 * As in float8_regr_accum, if we have not seen distinct inputs for X
+		 * (or Y) in either state, the corresponding sums should remain
+		 * exactly zero: both means are then exactly Cx, and computing the
+		 * correction terms from the rounded sums Sx1 and Sx2 would just
+		 * inject roundoff error.  We need exact zero results so that the
+		 * final functions will return NULL in the right cases.
+		 */
+		Sxx = Sxx1 + Sxx2;
+		if (isnan(Cx))
+			Sxx += N1 * N2 * tmp1 * tmp1 / N;
+		Syy = Syy1 + Syy2;
+		if (isnan(Cy))
+			Syy += N1 * N2 * tmp2 * tmp2 / N;
+		Sxy = Sxy1 + Sxy2;
+		if (isnan(Cx) && isnan(Cy))
+			Sxy += N1 * N2 * tmp1 * tmp2 / N;
+		else if (isnan(Sx) || isinf(Sx) ||
+				 isnan(Sy) || isinf(Sy))
+		{
+			/*
+			 * If one input has been constant so far, but the other one has
+			 * been Inf or NaN, we must force Sxy to NaN to avoid falsely
+			 * reporting variance zero.  (We can't see individual X/Y values
+			 * from here, but if any one has been Inf or NaN, the sum Sx/Sy
+			 * must now be Inf or NaN.)  Sxx and Syy don't have this issue.
+			 */
+			Sxy = get_float8_nan();
+		}
+
+		/*
+		 * Overflow check, same logic as in float8_regr_accum.
+		 */
+		if (isinf(Sx) || isinf(Sxx) || isinf(Sy) || isinf(Syy) || isinf(Sxy))
+		{
+			if (((isinf(Sx) || isinf(Sxx)) &&
+				 !isinf(Sx1) && !isinf(Sx2)) ||
+				((isinf(Sy) || isinf(Syy)) &&
+				 !isinf(Sy1) && !isinf(Sy2)) ||
+				(isinf(Sxy) &&
+				 !isinf(Sx1) && !isinf(Sx2) &&
+				 !isinf(Sy1) && !isinf(Sy2)))
+				float_overflow_error();
+
+			if (isinf(Sxx))
+				Sxx = get_float8_nan();
+			if (isinf(Syy))
+				Syy = get_float8_nan();
+			if (isinf(Sxy))
+				Sxy = get_float8_nan();
+		}
 	}
 
 	/*

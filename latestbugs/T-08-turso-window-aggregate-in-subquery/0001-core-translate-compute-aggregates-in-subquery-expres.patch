From d3e202af4e863791c5891768fb91795037db0df4 Mon Sep 17 00:00:00 2001
From: Venu Kummari <v.kummari@iitg.ac.in>
Date: Thu, 12 Nov 2026 16:40:18 +0000
Subject: [PATCH] core/translate: compute aggregates in subquery expressions of
 window queries

A query with a window function moves each result expression that holds a
subquery (IN, EXISTS, a scalar subquery) into the window's source
subquery, but always marked the new column as containing no aggregates.
An aggregate in such an expression, e.g. the left operand of
`max(x) IN (SELECT ...)`, was then translated as a scalar call: a
built-in aggregate failed with "misuse of aggregate function max()", and
an aggregate from an extension (median, percentile_disc, ...) panicked
with "aggregate called in scalar context".

Mark the column as containing aggregates when the expression contains
one of the query's aggregates, so that it is evaluated after aggregation.
---
 core/translate/window.rs                      | 24 +++++++-
 .../aggregate-in-subquery-operand.sqltest     | 61 +++++++++++++++++++
 2 files changed, 84 insertions(+), 1 deletion(-)
 create mode 100644 sqlite/conformance/sqlite-sqltests/window/aggregate-in-subquery-operand.sqltest

diff --git a/core/translate/window.rs b/core/translate/window.rs
index 4f232f6f2..573549d84 100644
--- a/core/translate/window.rs
+++ b/core/translate/window.rs
@@ -370,7 +370,12 @@ fn rewrite_terminal_expr(
                 | Expr::Exists(..)
                 | Expr::InSelect { .. }
                 | Expr::Subquery(..) => {
-                    rewrite_expr_as_subquery_column(expr, ctx, false);
+                    // The whole expression moves into the source subquery. If an
+                    // aggregate of this query appears in it, e.g. as the left operand
+                    // of `max(x) IN (SELECT ...)`, the new column must be evaluated
+                    // after aggregation there, like any other aggregate expression.
+                    let contains_aggregates = expr_contains_aggregate(expr, aggregates)?;
+                    rewrite_expr_as_subquery_column(expr, ctx, contains_aggregates);
                     return Ok(WalkControl::SkipChildren);
                 }
                 _ => {}
@@ -381,6 +386,23 @@ fn rewrite_terminal_expr(
     )
 }
 
+/// Whether `expr` contains one of `aggregates`, the aggregates of the query
+/// being rewritten. The bodies of subqueries are not searched.
+fn expr_contains_aggregate(expr: &Expr, aggregates: &[Aggregate]) -> crate::Result<bool> {
+    let mut found = false;
+    walk_expr(expr, &mut |e: &Expr| -> crate::Result<WalkControl> {
+        if aggregates
+            .iter()
+            .any(|a| exprs_are_equivalent(&a.original_expr, e))
+        {
+            found = true;
+            return Ok(WalkControl::SkipChildren);
+        }
+        Ok(WalkControl::Continue)
+    })?;
+    Ok(found)
+}
+
 /// Find the `WindowFunction` entry that this expression corresponds to.
 /// Returns an entry that has not been rewritten yet when one exists.
 fn find_window_function_entry<'a>(
diff --git a/sqlite/conformance/sqlite-sqltests/window/aggregate-in-subquery-operand.sqltest b/sqlite/conformance/sqlite-sqltests/window/aggregate-in-subquery-operand.sqltest
new file mode 100644
index 000000000..6728ae18b
--- /dev/null
+++ b/sqlite/conformance/sqlite-sqltests/window/aggregate-in-subquery-operand.sqltest
@@ -0,0 +1,61 @@
+@database :memory:
+
+# A query with a window function moves each result expression that holds a
+# subquery into the window's source subquery. An aggregate in such an
+# expression, e.g. the left operand of `max(x) IN (SELECT ...)`, must still
+# be computed there: it was rejected as a misuse of the aggregate, and an
+# aggregate from an extension crashed the process.
+
+setup items {
+    CREATE TABLE t(x INTEGER);
+    INSERT INTO t VALUES (1), (3);
+}
+
+@setup items
+test aggregate-in-operand-of-in-subquery-with-window {
+    SELECT max(x) IN (SELECT 1), max(x) IN (SELECT 3), count(*) OVER () FROM t;
+}
+expect {
+    0|1|1
+}
+
+@setup items
+test aggregate-in-operand-of-not-in-subquery-with-window {
+    SELECT sum(x) NOT IN (SELECT 4), sum(x) NOT IN (SELECT 5), row_number() OVER () FROM t;
+}
+expect {
+    0|1|1
+}
+
+@setup items
+test count-star-in-operand-of-in-subquery-with-window {
+    SELECT count(*) IN (SELECT 2), count(*) OVER () FROM t;
+}
+expect {
+    1|1
+}
+
+@setup items
+test aggregate-in-operand-of-in-subquery-window-in-order-by {
+    SELECT max(x) IN (SELECT 3) FROM t ORDER BY sum(x) OVER ();
+}
+expect {
+    1
+}
+
+@setup items
+test aggregate-in-operand-of-in-subquery-with-window-and-group-by {
+    SELECT x % 2, max(x) IN (SELECT 3), count(*) OVER () FROM t GROUP BY x % 2;
+}
+expect {
+    1|1|1
+}
+
+@setup items
+@skip-if sqlite "the CI SQLite build has no median() or percentile_disc()"
+test extension-aggregate-in-operand-of-in-subquery-with-window {
+    SELECT median(x) IN (SELECT 2), percentile_disc(x, 1) IN (SELECT 3), count(*) OVER () FROM t;
+}
+expect {
+    1|1|1
+}

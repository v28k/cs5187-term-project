 		preprocess_qual_conditions(root, j->larg);
 		preprocess_qual_conditions(root, j->rarg);
 
+		/*
+		 * Don't let NOT NULL constraints drive simplification of a FULL
+		 * JOIN's quals.  Reducing, say, "a.x IS NULL" to FALSE can remove all
+		 * references to one input from a clause that was hash- or
+		 * merge-joinable, and then the join cannot be planned at all.  See
+		 * var_is_nonnullable().
+		 */
+		if (j->jointype == JOIN_FULL)
+			root->inFullJoinQuals = true;
 		j->quals = preprocess_expression(root, j->quals, EXPRKIND_QUAL);
+		root->inFullJoinQuals = false;
